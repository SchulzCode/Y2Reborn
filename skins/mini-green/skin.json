  "titlebar": [
   {
    "type": "image",
    "x": 0,
    "y": 0,
    "w": 480,
    "h": 30,
    "image": "titlebar"
   },
   {
    "type": "icon",
    "if": "playing",
    "x": 10,
    "y": 7,
    "size": 16,
    "icon": "play",
    "color": "#5C9E33"
   },
   {
    "type": "icon",
    "if": "paused",
    "x": 10,
    "y": 7,
    "size": 16,
    "icon": "pause",
    "color": "#5C9E33"
   },
   {
    "type": "bar",
    "if": "!battery_low",
    "x": 442,
    "y": 10,
    "w": 22,
    "h": 10,
    "value": "battery",
    "fill_image": "battery_fill"
   },
   {
    "type": "bar",
    "if": "battery_low",
    "x": 442,
    "y": 10,
    "w": 22,
    "h": 10,
    "value": "battery",
    "fill_image": "battery_low"
   },
   {
    "type": "image",
    "x": 440,
    "y": 8,
    "w": 28,
    "h": 14,
    "image": "battery"
   },
